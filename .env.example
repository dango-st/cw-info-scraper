# MongoDB (required) — e.g. your Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=crowdworks_users

# Scraper behaviour
START_PAGE=1
MAX_PAGES=0            # 0 = no limit (stop when a page has no data)
DELAY_MS=2000          # wait between list pages
DETAIL_DELAY_MS=1500   # wait between user profile pages
MAX_RETRIES=3
TIMEOUT_MS=30000

# Web viewer
PORT=3000
