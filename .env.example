START_PAGE=1
MAX_PAGES=0            # 0 = no limit (stop when a page has no data)
DELAY_MS=2000          # wait between list pages
DETAIL_DELAY_MS=1500   # wait between user profile pages
MAX_RETRIES=3
TIMEOUT_MS=30000
OUTPUT_DIR=output

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=crowdworks
SAVE_FILES=true        # also write CSV/JSONL to OUTPUT_DIR
PORT=3000              # web viewer port

MONGODB_URI=
MONGODB_DB=crowdworks_users
SAVE_FILES=true
PORT=3000
